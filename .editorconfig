# 让编辑器对新文件的默认行尾与仓库约定一致：
# 源码沿用 CRLF（项目现状），但 *.sh / *.mjs 这些要在 Linux 上执行的脚本必须是 LF，
# 否则服务器上会报 "$'\r': command not found"。
root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = crlf

[*.sh]
end_of_line = lf

[*.mjs]
end_of_line = lf

[*.yml]
end_of_line = lf

[*.yaml]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
