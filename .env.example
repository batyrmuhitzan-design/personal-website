# ==========================================================================
#  DeepSeek Agent · 环境变量模板（提交进仓库，只有键名没有真实值）
#  用法：cp .env.example .env 然后把占位符换成真实值（.env 已被 .gitignore 忽略）
# ==========================================================================
#
#  三条硬规矩（改这个文件之前先读）：
#   1) 真实密钥只写在 .env 里，永远不要写进本模板或 AGENT_GUIDE.md；
#   2) 不要给密钥加 REACT_APP_ 前缀 —— CRA 会把 REACT_APP_* 打进前端产物，
#      等于把密钥公开到浏览器里（本项目 .dockerignore 已排除 .env，镜像里不会带）；
#   3) 不要占用 CRA / react-scripts 的保留变量名：
#      PORT HOST HTTPS BROWSER NODE_ENV CI BUILD_PATH PUBLIC_URL GENERATE_SOURCEMAP
#      INLINE_RUNTIME_CHUNK WDS_SOCKET_* DISABLE_ESLINT_PLUGIN TSC_COMPILE_ON_ERROR ...
#      （本站点地址因此命名为 SITE_PUBLIC_URL，而不是 PUBLIC_URL）
# ==========================================================================

# ---------------------------- DeepSeek 官方端点 ----------------------------
# OpenAI 兼容协议。取值位置：本机 Cline 配置 ~/.cline/data/secrets.json → deepSeekApiKey
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ------------------------- NVIDIA NIM（备用 DeepSeek） -------------------------
# 同样是 OpenAI 兼容协议，托管了 DeepSeek 系列；端点为 .../v1。
# 取值位置：~/.cline/data/secrets.json → openAiApiKey（nvapi- 开头）
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_NIM_MAX_INPUT_TOKENS=128000

# ------------------------------- 服务器 / SSH -------------------------------
# 免密登录已配好：~/.ssh/config 里的 Host 别名 kaznu → 74.241.248.9 (root)
AGENT_SSH_HOST=kaznu
AGENT_SERVER_IP=74.241.248.9
AGENT_SSH_KEY=~/.ssh/kaznu_deploy
# 服务器上的仓库副本（git clone 自 origin/master），deploy.sh 就在这个目录里执行
AGENT_REMOTE_DIR=/opt/personal-website
AGENT_GIT_BRANCH=master

# ------------------------------ 站点与端口 ------------------------------
# 公网入口：1Panel OpenResty 反代 https://i.1losion.me → 127.0.0.1:8881
SITE_PUBLIC_URL=https://i.1losion.me
AGENT_LOCAL_PORT=8881
AGENT_COMPOSE_PROJECT=personal-website
# 部署后健康检查的超时秒数（小水管服务器第一次构建较慢，别设太小）
AGENT_HEALTH_TIMEOUT=120

# --------------------- 其它服务（只读参考，不要改） ---------------------
# 与本站同机运行、但属于别的项目：改之前先确认，别误伤
AGENT_FAKA_DIR=/opt/shasha-faka
AGENT_FAKA_ENV_FILE=/opt/shasha-faka/.env
AGENT_FAKA_WEB_PORT=8882
AGENT_NODEBB_PORT=4567
AGENT_ROOT_SITE_PORT=8000
AGENT_PANEL_PORT=39888
